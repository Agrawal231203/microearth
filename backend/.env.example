# Copy to .env and adjust as needed. All values are optional; sane defaults are used.

# Where uploaded .slpk files and extracted I3S trees are stored on disk.
SLPK_UPLOAD_DIR=./storage/uploads
SLPK_EXTRACT_DIR=./storage/extracted

# Max upload size in bytes (default 2GB)
SLPK_MAX_UPLOAD_SIZE=2147483648

# React frontend origin
SLPK_CORS_ORIGINS=http://13.202.113.121

# Public URL through Nginx
SLPK_PUBLIC_BASE_URL=http://13.202.113.121
